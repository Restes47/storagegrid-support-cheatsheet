Log Analysis (Most Important)
bash
# View live logs (tail)
tail -f /var/local/log/bycast.log
tail -f /var/local/log/servermanager.log

# Search for errors
grep -i "error" /var/local/log/bycast.log
grep -i "error" /var/local/log/servermanager.log

# Search for specific patterns
grep -i "s3\|connection\|timeout" /var/local/log/bycast.log
grep -i "ssl\|certificate" /var/local/log/bycast.log

# Show last N lines
tail -n 100 /var/local/log/bycast.log
head -n 50 /var/local/log/bycast.log

# Search with line numbers
grep -n "pattern" /var/local/log/bycast.log

# Count occurrences
grep -c "error" /var/local/log/bycast.log

# Case-insensitive search with context (show 5 lines before/after)
grep -iC 5 "connection refused" /var/local/log/bycast.log

